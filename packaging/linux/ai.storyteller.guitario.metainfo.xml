<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata, so software centres can describe Guitario. -->
<component type="desktop-application">
  <id>ai.storyteller.guitario</id>
  <name>Guitario</name>
  <summary>Guitar tablature and notation editor</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <description>
    <p>Write, play and print guitar tablature and standard notation. Guitario opens and saves
    Guitar Pro files, imports and exports MIDI and MusicXML, and plays scores back with
    articulated guitars, bass and drums.</p>
  </description>
  <developer id="ai.storyteller">
    <name>Guitario contributors</name>
  </developer>
  <url type="homepage">https://github.com/timothydaly1/guitario</url>
  <url type="bugtracker">https://github.com/timothydaly1/guitario/issues</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">ai.storyteller.guitario.desktop</launchable>
  <categories>
    <category>Audio</category>
    <category>Music</category>
  </categories>
  <provides>
    <binary>guitario</binary>
    <mediatype>application/x-guitario</mediatype>
    <mediatype>application/x-guitar-pro</mediatype>
  </provides>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
